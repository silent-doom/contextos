# Local default: synthetic sandbox with explicit deterministic rehearsal
AUTH_MODE=demo
AI_MODE=offline
STORE_BACKEND=sqlite
DATABASE_PATH=.data/contextos.db

# Live Google Cloud configuration (Vertex AI + Firestore)
# AI_MODE=vertex
# STORE_BACKEND=firestore
# GOOGLE_CLOUD_PROJECT=contextos-512006
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-2.5-flash

# Alternative: Google AI Studio API key, supplied only to server environment
# AI_MODE=gemini
# GEMINI_API_KEY=replace-locally-never-commit

# For provisioned real accounts use Firebase-verified bearer tokens
# AUTH_MODE=firebase
# K_SERVICE is set automatically by Cloud Run; do not set it locally.
# This file is documentation. Environment loading is explicit; see DEPLOYMENT.md.

# Public Firebase Web API key for email/password sign-in (not a service credential).
# Enable Email/Password in Firebase Auth and provision role/workspace custom claims.
# FIREBASE_WEB_API_KEY=your-firebase-web-api-key
